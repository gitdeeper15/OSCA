include README.md
include LICENSE
include requirements.txt
include CHANGELOG.md
include VERSION
include CITATION.cff

recursive-include core *.py
recursive-include invariants *.py
recursive-include sandbox *.py
recursive-include tests *.py

recursive-include DOCS *.md
recursive-include RESEARCH_PAPER *.pdf

prune .venv
prune .git
prune dist
prune build
prune __pycache__
global-exclude *.pyc
global-exclude *.pyo
